{
  "_isc_version": "1.0.0",
  "name": "ISC — KPI Breach Alert",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "isc-kpi-breach",
        "responseMode": "onReceived",
        "responseData": "firstEntryJson",
        "options": {}
      },
      "id": "b2c3d4e5-0002-0002-0002-000000000001",
      "name": "ISC Webhook — kpi.threshold_breach",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [240, 300],
      "webhookId": "REPLACE_WITH_YOUR_WEBHOOK_UUID"
    },
    {
      "parameters": {
        "dataType": "string",
        "value1": "={{ $json.body.severity }}",
        "rules": {
          "rules": [
            { "value2": "warn",     "outputIndex": 0 },
            { "value2": "critical", "outputIndex": 1 }
          ]
        },
        "fallbackOutput": "none"
      },
      "id": "b2c3d4e5-0002-0002-0002-000000000002",
      "name": "Route by Severity",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 2,
      "position": [480, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://hooks.slack.com/services/REPLACE/WITH/YOUR_SLACK_WEBHOOK",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "text",
              "value": "=⚠️ *KPI Warning* — `{{ $('ISC Webhook — kpi.threshold_breach').item.json.body.kpiLabel }}` is at {{ $('ISC Webhook — kpi.threshold_breach').item.json.body.value }} (warn threshold: {{ $('ISC Webhook — kpi.threshold_breach').item.json.body.warnThreshold }}). Review in ISC: https://YOUR_ISC_DOMAIN/"
            }
          ]
        }
      },
      "id": "b2c3d4e5-0002-0002-0002-000000000003",
      "name": "Slack — Warn Notification",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [720, 180]
    },
    {
      "parameters": {
        "fromEmail": "alerts@YOUR_ISC_DOMAIN",
        "toEmail": "REPLACE_WITH_ALERT_RECIPIENT@example.com",
        "subject": "=🚨 CRITICAL KPI Breach — {{ $('ISC Webhook — kpi.threshold_breach').item.json.body.kpiLabel }}",
        "emailType": "html",
        "html": "<h2 style='color:#dc2626'>🚨 Critical KPI Breach</h2><p><strong>KPI:</strong> {{ $('ISC Webhook — kpi.threshold_breach').item.json.body.kpiLabel }}<br/><strong>Current Value:</strong> {{ $('ISC Webhook — kpi.threshold_breach').item.json.body.value }}<br/><strong>Critical Threshold:</strong> {{ $('ISC Webhook — kpi.threshold_breach').item.json.body.criticalThreshold }}<br/><strong>User:</strong> {{ $('ISC Webhook — kpi.threshold_breach').item.json.body.userId }}</p><p><a href='https://YOUR_ISC_DOMAIN/'>→ View in ISC Platform</a></p>"
      },
      "id": "b2c3d4e5-0002-0002-0002-000000000004",
      "name": "Email — Critical Alert",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2,
      "position": [720, 360],
      "credentials": {
        "gmailOAuth2": {
          "id": "REPLACE_WITH_GMAIL_CREDENTIAL_ID",
          "name": "Gmail — ISC Alerts"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.twilio.com/2010-04-01/Accounts/REPLACE_ACCOUNT_SID/Messages.json",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "twilioApi",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            { "name": "To",   "value": "REPLACE_WITH_RECIPIENT_PHONE" },
            { "name": "From", "value": "REPLACE_WITH_TWILIO_PHONE" },
            { "name": "Body", "value": "=🚨 CRITICAL KPI Breach: {{ $('ISC Webhook — kpi.threshold_breach').item.json.body.kpiLabel }} = {{ $('ISC Webhook — kpi.threshold_breach').item.json.body.value }}. Log in to ISC immediately." }
          ]
        }
      },
      "id": "b2c3d4e5-0002-0002-0002-000000000005",
      "name": "Twilio — Critical SMS",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [720, 520],
      "credentials": {
        "twilioApi": {
          "id": "REPLACE_WITH_TWILIO_CREDENTIAL_ID",
          "name": "Twilio — ISC Alerts"
        }
      }
    }
  ],
  "connections": {
    "ISC Webhook — kpi.threshold_breach": {
      "main": [
        [{ "node": "Route by Severity", "type": "main", "index": 0 }]
      ]
    },
    "Route by Severity": {
      "main": [
        [{ "node": "Slack — Warn Notification", "type": "main", "index": 0 }],
        [
          { "node": "Email — Critical Alert", "type": "main", "index": 0 },
          { "node": "Twilio — Critical SMS",  "type": "main", "index": 0 }
        ]
      ]
    }
  },
  "active": false,
  "settings": { "executionOrder": "v1" },
  "versionId": "1.0.0",
  "meta": {
    "templateCredsSetupCompleted": false,
    "isc": {
      "triggerEvent": "kpi.threshold_breach",
      "webhookUrlPlaceholder": "https://YOUR_N8N_INSTANCE/webhook/isc-kpi-breach",
      "setupSteps": [
        "1. Import this JSON into n8n.",
        "2. Connect Gmail and Twilio credentials (or replace Twilio with your SMS provider).",
        "3. Paste your Slack Incoming Webhook URL into the Slack node.",
        "4. Copy the n8n Webhook URL and register it in ISC → Integration Hub → Webhooks with event 'kpi.threshold_breach'.",
        "5. Replace placeholder phone numbers and email addresses.",
        "6. Activate the workflow."
      ],
      "nodeDetails": [
        { "nodeName": "ISC Webhook — kpi.threshold_breach", "detail": "Listens for the kpi.threshold_breach event on path /isc-kpi-breach" },
        { "nodeName": "Route by Severity", "detail": "Routes on body.severity — 'warn' → Slack only, 'critical' → Gmail + Twilio SMS" },
        { "nodeName": "Slack — Warn Notification", "detail": "POSTs to your Slack Incoming Webhook URL with the KPI label and warn threshold value" },
        { "nodeName": "Email — Critical Alert", "detail": "Sends subject: \"🚨 CRITICAL KPI Breach — {kpiLabel}\" to your configured alert recipient" },
        { "nodeName": "Twilio — Critical SMS", "detail": "Sends a critical-alert SMS via Twilio API with the KPI name and current value" }
      ]
    }
  }
}
