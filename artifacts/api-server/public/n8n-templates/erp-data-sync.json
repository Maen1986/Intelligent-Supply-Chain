{
  "_isc_version": "1.0.0",
  "name": "ISC — ERP Data Sync (Daily)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [{ "field": "cronExpression", "expression": "0 2 * * *" }]
        }
      },
      "id": "a7b8c9d0-0007-0007-0007-000000000001",
      "name": "Daily Trigger (02:00 UTC)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1,
      "position": [240, 300]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "https://YOUR_ERP_BASE_URL/api/kpis",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "Bearer REPLACE_WITH_ERP_API_TOKEN" },
            { "name": "Content-Type",  "value": "application/json" }
          ]
        },
        "options": { "timeout": 30000 }
      },
      "id": "a7b8c9d0-0007-0007-0007-000000000002",
      "name": "Fetch KPIs from ERP",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [480, 200]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "https://YOUR_ERP_BASE_URL/api/suppliers",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "Bearer REPLACE_WITH_ERP_API_TOKEN" },
            { "name": "Content-Type",  "value": "application/json" }
          ]
        },
        "options": { "timeout": 30000 }
      },
      "id": "a7b8c9d0-0007-0007-0007-000000000003",
      "name": "Fetch Suppliers from ERP",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [480, 420]
    },
    {
      "parameters": {
        "jsCode": "// Map ERP KPI fields → ISC import format.\n// Adjust field names to match your ERP's response schema.\nconst erpKpis = $input.first().json.kpis ?? $input.first().json ?? [];\nconst kpis = erpKpis.map(k => ({\n  id:     k.kpi_code  ?? k.id   ?? k.code,\n  label:  k.kpi_name  ?? k.name ?? k.label,\n  value:  k.kpi_value ?? k.value,\n  unit:   k.unit      ?? '%',\n  target: k.target    ?? k.kpi_target,\n  period: k.period    ?? new Date().toISOString().slice(0, 7), // YYYY-MM\n}));\nreturn [{ json: { kpis } }];"
      },
      "id": "a7b8c9d0-0007-0007-0007-000000000004",
      "name": "Map KPI Fields",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [720, 200]
    },
    {
      "parameters": {
        "jsCode": "// Map ERP Supplier fields → ISC import format.\nconst erpSuppliers = $input.first().json.suppliers ?? $input.first().json ?? [];\nconst suppliers = erpSuppliers.map(s => ({\n  name:          s.supplier_name ?? s.name,\n  category:      s.category      ?? s.type ?? 'General',\n  qualityScore:  s.quality_score ?? s.quality ?? null,\n  deliveryScore: s.delivery_score ?? s.delivery ?? null,\n  costScore:     s.cost_score    ?? s.cost    ?? null,\n  country:       s.country       ?? null,\n  contactEmail:  s.email         ?? s.contact_email ?? null,\n}));\nreturn [{ json: { suppliers } }];"
      },
      "id": "a7b8c9d0-0007-0007-0007-000000000005",
      "name": "Map Supplier Fields",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [720, 420]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://YOUR_ISC_DOMAIN/api/v1/kpis/import",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "x-api-key",     "value": "REPLACE_WITH_ISC_API_KEY" },
            { "name": "Content-Type",  "value": "application/json" }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            { "name": "kpis", "value": "={{ JSON.stringify($json.kpis) }}" }
          ]
        }
      },
      "id": "a7b8c9d0-0007-0007-0007-000000000006",
      "name": "POST KPIs to ISC",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [960, 200]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://YOUR_ISC_DOMAIN/api/v1/suppliers/import",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "x-api-key",    "value": "REPLACE_WITH_ISC_API_KEY" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            { "name": "suppliers", "value": "={{ JSON.stringify($json.suppliers) }}" }
          ]
        }
      },
      "id": "a7b8c9d0-0007-0007-0007-000000000007",
      "name": "POST Suppliers to ISC",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [960, 420]
    }
  ],
  "connections": {
    "Daily Trigger (02:00 UTC)": {
      "main": [
        [
          { "node": "Fetch KPIs from ERP",       "type": "main", "index": 0 },
          { "node": "Fetch Suppliers from ERP",   "type": "main", "index": 0 }
        ]
      ]
    },
    "Fetch KPIs from ERP": {
      "main": [
        [{ "node": "Map KPI Fields", "type": "main", "index": 0 }]
      ]
    },
    "Fetch Suppliers from ERP": {
      "main": [
        [{ "node": "Map Supplier Fields", "type": "main", "index": 0 }]
      ]
    },
    "Map KPI Fields": {
      "main": [
        [{ "node": "POST KPIs to ISC", "type": "main", "index": 0 }]
      ]
    },
    "Map Supplier Fields": {
      "main": [
        [{ "node": "POST Suppliers to ISC", "type": "main", "index": 0 }]
      ]
    }
  },
  "active": false,
  "settings": { "executionOrder": "v1" },
  "versionId": "1.0.0",
  "meta": {
    "templateCredsSetupCompleted": false,
    "isc": {
      "triggerEvent": "cron.daily",
      "webhookUrlPlaceholder": null,
      "setupSteps": [
        "1. Import this JSON into n8n.",
        "2. Replace YOUR_ERP_BASE_URL and REPLACE_WITH_ERP_API_TOKEN with your ERP's API base URL and token.",
        "3. Replace YOUR_ISC_DOMAIN and REPLACE_WITH_ISC_API_KEY with your ISC platform URL and an API key with write scope.",
        "4. Review the field mapping Code nodes — adjust property names to match your ERP's actual response schema.",
        "5. This workflow uses a built-in Schedule Trigger (daily at 02:00 UTC) — no ISC webhook registration needed.",
        "6. Activate the workflow."
      ]
    }
  }
}
