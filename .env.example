# Copy to .env and fill in real values. This project does not auto-load a
# .env file (no dotenv dependency) -- export these as real environment
# variables using whatever mechanism fits your setup (direnv, your shell
# profile, `export $(cat .env | xargs)`, your platform's own env-var config).

# ── Required to boot ─────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/isc_dev
PORT=5000
BASE_PATH=/

# ── Required only if you use the feature ─────────────────────────────────
# AI-generated content (Consultancy Engine, Executive Briefing, etc.) throws
# without this.
AI_INTEGRATIONS_OPENAI_API_KEY=

# File/object storage upload routes.
PRIVATE_OBJECT_DIR=
PUBLIC_OBJECT_SEARCH_PATHS=

# Outbound email.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Webhook integrations.
N8N_WEBHOOK_SECRET=
N8N_LEAD_WEBHOOK_URL=
INBOUND_WEBHOOK_SECRET=

# Grants the account with this email the 'admin' role on login. Real secret
# -- do not commit an actual value.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ── Optional, has a working default ──────────────────────────────────────
# Falls back to a dev-only value in code -- set a real secret outside local dev.
SESSION_SECRET=

ALLOWED_ORIGINS=
LOG_LEVEL=info
OPENAI_MODEL=
OPENAI_TTS_MODEL=
EMAIL_RETRY_DELAY_MS=
APP_URL=

# ── Do not set manually ──────────────────────────────────────────────────
# REPLIT_* / REPL_ID / METADATA_SERVER_DETECTION are auto-injected by Replit.
